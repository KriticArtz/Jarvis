# Public values only (they are bundled into the app, like the web app's NEXT_PUBLIC_* values).
# Never put a Supabase secret/service-role key here.
EXPO_PUBLIC_JARVIS_API_URL=https://your-jarvis-domain
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Identifiers you own (used by app.config.ts)
JARVIS_IOS_BUNDLE_ID=com.yourcompany.jarvis
JARVIS_ANDROID_PACKAGE=com.yourcompany.jarvis
