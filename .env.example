# =============================================================================
# LifePilot environment variables
# Copy to .env.local for local development:  cp .env.example .env.local
# Never commit real values. Variables WITHOUT the NEXT_PUBLIC_ prefix are only
# ever read on the server and are never sent to the browser.
# =============================================================================

# --- App ---------------------------------------------------------------------
# Public origin of the app. Used for auth email links and to verify Twilio
# webhook signatures (must exactly match the URL Twilio calls).
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (REQUIRED) -----------------------------------------------------
# Supabase Dashboard → Project Settings → API (or Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or the legacy "anon" key. Safe for the
# browser: every query is restricted by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=   # legacy name, also accepted

# Secret key (sb_secret_...) or legacy "service_role" key. SERVER ONLY — it
# bypasses Row Level Security. Needed for SMS (sending, the cron dispatcher and
# the Twilio webhook). Core app features work without it.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=             # new-style name, also accepted

# --- OpenAI (optional; without it the app runs in "demo mode") ---------------
# https://platform.openai.com/api-keys — SERVER ONLY.
# Without a key: chat replies summarize your data and say AI isn't configured,
# plans use a deterministic rule-based planner, reviews use factual summaries.
OPENAI_API_KEY=
# Any chat-completions model that supports JSON-schema structured output.
OPENAI_MODEL=gpt-5-mini

# --- SMS / Twilio (optional) -------------------------------------------------
# SMS_MODE:
#   test     (default) record messages in the notifications table, never send
#   live     send real texts via Twilio (requires the TWILIO_* values below;
#            falls back to test if any are missing)
#   disabled don't record or send anything
SMS_MODE=test
# Twilio Console → Account Info. TWILIO_AUTH_TOKEN is SERVER ONLY.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use a Messaging Service (recommended; required for A2P 10DLC in the US) ...
TWILIO_MESSAGING_SERVICE_SID=
# ... or a single sending number in E.164 format, e.g. +15551234567.
# (TWILIO_FROM_NUMBER is accepted as an alias.)
TWILIO_PHONE_NUMBER=
# Public https origin Twilio calls for webhooks, used to verify
# X-Twilio-Signature. For a local demo set it to your ngrok URL
# (e.g. https://abc123.ngrok-free.app). Defaults to NEXT_PUBLIC_APP_URL.
TWILIO_WEBHOOK_BASE_URL=

# --- Cron --------------------------------------------------------------------
# Shared secret for /api/cron/dispatch. Vercel Cron sends it automatically as
# "Authorization: Bearer <CRON_SECRET>". Generate with: openssl rand -hex 32
CRON_SECRET=
